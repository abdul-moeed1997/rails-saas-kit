# Secrets defined here are available for reference under registry/password, env/secret,
# builder/secrets, and accessories/*/env/secret in config/deploy.yml. All secrets should
# be pulled from password manager, ENV, or Rails credentials — never hardcode values.

# Production credentials key (decrypts config/credentials/production.yml.enc)
RAILS_MASTER_KEY=$(cat config/credentials/production.key)

# Registry password — only needed when kamal.registry.username is set in credentials
KAMAL_REGISTRY_PASSWORD=$(RAILS_ENV=production bin/rails credentials:fetch kamal.registry_password)

# Database password — used by the app and the Postgres accessory (when enabled)
RAILS_SAAS_KIT_DATABASE_PASSWORD=$(RAILS_ENV=production bin/rails credentials:fetch kamal.database.password)
POSTGRES_PASSWORD=$RAILS_SAAS_KIT_DATABASE_PASSWORD

