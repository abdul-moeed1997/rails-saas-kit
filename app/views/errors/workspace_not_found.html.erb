<% content_for :title, "Workspace not found" %>

<div class="mx-auto w-full max-w-2xl space-y-4">
  <h1 class="text-3xl font-semibold tracking-tight text-zinc-900">Workspace not found</h1>
  <p class="text-zinc-600">
    There is no organization at this address. Check the URL or ask your admin for the correct workspace link.
  </p>
  <%= link_to "Go to homepage",
              root_url(host: workspace_domain, port: request.port),
              class:
                "inline-flex rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
</div>
