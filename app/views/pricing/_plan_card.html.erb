<%
  month_price = plan.price_for("month")
  year_price = plan.price_for("year")
  month_display = pricing_amount_display(month_price)
  year_display = pricing_amount_display_annual(month_price, year_price)
  savings = annual_savings_percent(plan)
  highlighted = plan.highlighted?
  card_features = pricing_card_features(plan, features)
%>

<article
  class="<%= highlighted ? "lg:z-10 lg:shadow-xl ring-2 ring-indigo-600" : "ring-1 ring-zinc-200" %> flex h-full flex-col rounded-3xl bg-white p-8 shadow-sm xl:p-10"
>
  <% if highlighted %>
    <p class="mb-6 w-fit rounded-full bg-indigo-600/10 px-3 py-1 text-xs font-semibold text-indigo-700">
      Most popular
    </p>
  <% else %>
    <div class="mb-6 h-6" aria-hidden="true"></div>
  <% end %>

  <div class="flex items-center justify-between gap-x-4">
    <h2 class="text-lg font-semibold leading-8 text-zinc-900"><%= plan.name %></h2>
  </div>

  <% if plan.description.present? %>
    <p class="mt-4 text-sm leading-6 text-zinc-600"><%= plan.description %></p>
  <% end %>

  <div class="mt-6 min-h-[5.5rem]">
    <p class="flex items-baseline gap-x-1">
      <span
        class="text-4xl font-semibold tracking-tight text-zinc-900"
        data-pricing-target="amount"
        data-month-amount="<%= month_display[:amount] %>"
        data-year-amount="<%= year_display[:amount] %>"
      >
        <%= month_display[:amount] %>
      </span>
      <span
        class="<%= month_display[:period] ? "text-sm font-semibold leading-6 text-zinc-600" : "hidden text-sm font-semibold leading-6 text-zinc-600" %>"
        data-pricing-target="period"
        data-month-period="<%= month_display[:period] %>"
        data-year-period="<%= year_display[:period] %>"
      >
        <%= month_display[:period] %>
      </span>
    </p>

    <p
      class="mt-2 hidden min-h-[1.25rem] text-sm text-zinc-500"
      data-pricing-target="subtext"
      data-month-subtext=""
      data-year-subtext="<%= year_display[:subtext] %>"
    ></p>

    <% if savings %>
      <p
        class="mt-2 hidden text-sm font-medium text-indigo-600"
        data-pricing-target="savings"
        data-year-savings="<%= savings %>"
      ></p>
    <% end %>
  </div>

  <ul class="mt-8 flex-1 space-y-3 text-sm leading-6 text-zinc-600">
    <% card_features.each do |label| %>
      <li class="flex gap-3">
        <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 size-5 shrink-0 text-indigo-600" aria-hidden="true">
          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
        </svg>
        <span><%= label %></span>
      </li>
    <% end %>
  </ul>

  <%= link_to pricing_cta_label(plan),
              pricing_cta_path(plan),
              class: [
                "mt-8 block w-full rounded-lg px-3.5 py-2.5 text-center text-sm font-semibold shadow-sm transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2",
                highlighted ? "bg-indigo-600 text-white hover:bg-indigo-500 focus-visible:outline-indigo-600" : "bg-indigo-50 text-indigo-700 hover:bg-indigo-100 focus-visible:outline-indigo-600"
              ].join(" ") %>
</article>
