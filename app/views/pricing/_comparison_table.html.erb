<section class="space-y-8">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-2xl font-semibold tracking-tight text-zinc-900"><%= t("pricing.comparison_table.heading") %></h2>
    <p class="mt-2 text-sm leading-6 text-zinc-600"><%= t("pricing.comparison_table.subheading") %></p>
  </div>

  <div class="-mx-4 overflow-x-auto sm:mx-0">
    <div class="inline-block min-w-full align-middle">
      <div class="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm">
        <table class="min-w-full divide-y divide-zinc-200 text-sm">
          <thead>
            <tr class="bg-zinc-50">
              <th scope="col" class="py-4 pl-6 pr-3 text-left font-semibold text-zinc-900"><%= t("pricing.comparison_table.feature_column") %></th>
              <% plans.each do |plan| %>
                <th scope="col" class="px-4 py-4 text-center font-semibold text-zinc-900">
                  <%= plan.name %>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100 bg-white">
            <% features.each do |feature| %>
              <tr>
                <th scope="row" class="py-4 pl-6 pr-3 text-left font-medium text-zinc-900">
                  <%= feature.name %>
                  <% if feature.description.present? %>
                    <span class="mt-0.5 block text-xs font-normal text-zinc-500"><%= feature.description %></span>
                  <% end %>
                </th>
                <% plans.each do |plan| %>
                  <td class="px-4 py-4 text-center">
                    <%= pricing_feature_label(plan, feature) %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
