<div class="mx-auto max-w-lg space-y-6">
  <h1 class="text-3xl font-semibold tracking-tight text-zinc-900"><%= t("admin.subscriptions.edit_title") %></h1>
  <p class="text-sm text-zinc-600"><%= @account.name %></p>

  <%= form_with model: @subscription, url: admin_account_subscription_path(@account), class: "space-y-4" do |f| %>
    <div class="space-y-2">
      <%= f.label :price_id, t("admin.subscriptions.price"), class: "block text-sm font-medium text-zinc-700" %>
      <%= f.collection_select :price_id,
                              @prices,
                              :id,
                              ->(price) { "#{price.plan.name} — #{price.interval} (#{number_to_currency(price.amount_cents / 100.0)})" },
                              {},
                              class: "block w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm" %>
    </div>

    <div class="space-y-2">
      <%= f.label :status, t("admin.subscriptions.status"), class: "block text-sm font-medium text-zinc-700" %>
      <%= f.select :status,
                   Subscription::STATUSES.map { |s| [t("subscription_statuses.#{s}", default: s.humanize), s] },
                   {},
                   class: "block w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm" %>
    </div>

    <div class="flex gap-2">
      <%= f.submit t("actions.update"), class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
      <%= link_to t("actions.cancel"), admin_account_path(@account), class: "rounded-lg border border-zinc-300 px-4 py-2 text-sm font-semibold text-zinc-700 hover:bg-zinc-50" %>
    </div>
  <% end %>
</div>
