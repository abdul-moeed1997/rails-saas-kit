<div class="space-y-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <h1 class="text-3xl font-semibold tracking-tight text-zinc-900"><%= @account.name %></h1>
    <div class="flex flex-wrap gap-2">
      <%= link_to t("admin.accounts.edit"), edit_admin_account_path(@account),
                  class: "rounded-lg border border-zinc-300 px-4 py-2 text-sm font-semibold text-zinc-700 hover:bg-zinc-50" %>
      <%= link_to t("admin.accounts.edit_subscription"), edit_admin_account_subscription_path(@account),
                  class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
    </div>
  </div>

  <section class="rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-sm space-y-3">
    <h2 class="text-lg font-semibold text-zinc-900"><%= t("admin.accounts.show_title") %></h2>
    <p class="text-sm text-zinc-600"><%= t("admin.accounts.subdomain") %>: <span class="font-medium text-zinc-900"><%= @account.subdomain %></span></p>
  </section>

  <section class="rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-sm space-y-4">
    <h2 class="text-lg font-semibold text-zinc-900"><%= t("admin.accounts.subscription") %></h2>
    <% if @subscription %>
      <p class="text-sm text-zinc-600">
        <%= t("admin.accounts.plan") %>:
        <span class="font-medium text-zinc-900"><%= @subscription.plan.name %></span>
        (<%= @subscription.price.interval %> — <%= number_to_currency(@subscription.price.amount_cents / 100.0) %>)
      </p>
      <p class="text-sm text-zinc-600">
        <%= t("admin.accounts.status") %>:
        <span class="font-medium text-zinc-900"><%= t("subscription_statuses.#{@subscription.status}", default: @subscription.status.humanize) %></span>
      </p>
      <% if @subscription.stripe_customer_id.present? %>
        <p class="text-sm text-zinc-600"><%= t("admin.accounts.stripe_customer_id") %>: <code class="text-xs"><%= @subscription.stripe_customer_id %></code></p>
      <% end %>
      <% if @subscription.stripe_subscription_id.present? %>
        <p class="text-sm text-zinc-600"><%= t("admin.accounts.stripe_subscription_id") %>: <code class="text-xs"><%= @subscription.stripe_subscription_id %></code></p>
      <% end %>
      <%= button_to t("admin.accounts.reset_subscription"),
                    reset_subscription_admin_account_path(@account),
                    method: :post,
                    class: "rounded-lg border border-amber-300 bg-amber-50 px-4 py-2 text-sm font-semibold text-amber-900 hover:bg-amber-100",
                    form: { data: { turbo_confirm: t("admin.accounts.reset_subscription_confirm") } } %>
    <% else %>
      <p class="text-sm text-zinc-600"><%= t("admin.accounts.none") %></p>
    <% end %>
  </section>

  <section class="rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-zinc-900"><%= t("admin.accounts.team") %></h2>
    <ul class="mt-4 divide-y divide-zinc-100">
      <% @users.each do |user| %>
        <li class="flex items-center justify-between py-3 text-sm">
          <span class="font-medium text-zinc-900"><%= user.email %></span>
          <span class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium text-zinc-600"><%= t("user.roles.#{user.role}") %></span>
        </li>
      <% end %>
    </ul>
  </section>
</div>
