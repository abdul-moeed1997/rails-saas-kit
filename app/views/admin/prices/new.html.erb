<div class="mx-auto max-w-lg space-y-6">
  <h1 class="text-3xl font-semibold tracking-tight text-zinc-900"><%= t("admin.prices.new_title") %></h1>
  <p class="text-sm text-zinc-600"><%= @plan.name %></p>

  <%= form_with model: [ :admin, @plan, @price ], class: "space-y-4" do |f| %>
    <%= render "admin/shared/form_errors", record: @price %>

    <div class="space-y-2">
      <%= f.label :amount_cents, t("admin.plans.amount"), class: "block text-sm font-medium text-zinc-700" %>
      <%= f.number_field :amount_cents, class: "block w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm" %>
    </div>

    <div class="space-y-2">
      <%= f.label :interval, t("admin.plans.interval"), class: "block text-sm font-medium text-zinc-700" %>
      <%= f.select :interval, Price::INTERVALS, {}, class: "block w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm" %>
    </div>

    <label class="flex items-center gap-2 text-sm text-zinc-700">
      <%= f.check_box :active, class: "rounded border-zinc-300" %>
      <%= t("admin.plans.active") %>
    </label>

    <div class="flex gap-2">
      <%= f.submit t("actions.update"), class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
      <%= link_to t("actions.cancel"), admin_plan_path(@plan), class: "rounded-lg border border-zinc-300 px-4 py-2 text-sm font-semibold text-zinc-700 hover:bg-zinc-50" %>
    </div>
  <% end %>
</div>
