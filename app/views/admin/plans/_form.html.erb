<div class="mx-auto max-w-3xl space-y-6">
  <h1 class="text-3xl font-semibold tracking-tight text-zinc-900"><%= title %></h1>

  <%= form_with model: [:admin, plan], class: "space-y-6" do |f| %>
    <%= render "admin/shared/form_errors", record: plan %>

    <div class="grid gap-4 sm:grid-cols-2">
      <div class="space-y-2">
        <%= f.label :name, t("admin.plans.name"), class: "block text-sm font-medium text-zinc-700" %>
        <%= f.text_field :name, class: "block w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm" %>
      </div>
      <div class="space-y-2">
        <%= f.label :slug, t("admin.plans.slug"), class: "block text-sm font-medium text-zinc-700" %>
        <%= f.text_field :slug, class: "block w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm" %>
      </div>
    </div>

    <div class="space-y-2">
      <%= f.label :description, t("admin.plans.description"), class: "block text-sm font-medium text-zinc-700" %>
      <%= f.text_area :description, rows: 3, class: "block w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm" %>
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
      <div class="space-y-2">
        <%= f.label :status, t("admin.plans.status"), class: "block text-sm font-medium text-zinc-700" %>
        <%= f.select :status, Plan::STATUSES, {}, class: "block w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm" %>
      </div>
      <div class="space-y-2">
        <%= f.label :position, t("admin.plans.position"), class: "block text-sm font-medium text-zinc-700" %>
        <%= f.number_field :position, class: "block w-full rounded-lg border border-zinc-300 px-3 py-2 text-sm" %>
      </div>
      <div class="flex items-end pb-2">
        <label class="flex items-center gap-2 text-sm text-zinc-700">
          <%= f.check_box :highlighted, class: "rounded border-zinc-300" %>
          <%= t("admin.plans.highlighted") %>
        </label>
      </div>
    </div>

    <section class="rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-sm space-y-4">
      <h2 class="text-lg font-semibold text-zinc-900"><%= t("admin.plans.entitlements") %></h2>
      <%= f.fields_for :plan_features do |pf| %>
        <div class="flex flex-wrap items-center gap-4 border-b border-zinc-100 pb-3">
          <%= pf.hidden_field :feature_id %>
          <%= pf.hidden_field :id %>
          <span class="min-w-32 text-sm font-medium text-zinc-900"><%= pf.object.feature&.name %></span>
          <label class="flex items-center gap-2 text-sm text-zinc-700">
            <%= pf.check_box :enabled, class: "rounded border-zinc-300" %>
            <%= t("admin.plans.enabled") %>
          </label>
          <div class="flex items-center gap-2">
            <%= pf.label :limit_value, t("admin.plans.limit"), class: "text-sm text-zinc-600" %>
            <%= pf.number_field :limit_value, class: "w-24 rounded-lg border border-zinc-300 px-2 py-1 text-sm" %>
          </div>
        </div>
      <% end %>
    </section>

    <div class="flex gap-2">
      <%= f.submit t("actions.update"), class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500" %>
      <%= link_to t("actions.cancel"), plan.persisted? ? admin_plan_path(plan) : admin_plans_path,
                  class: "rounded-lg border border-zinc-300 px-4 py-2 text-sm font-semibold text-zinc-700 hover:bg-zinc-50" %>
    </div>
  <% end %>
</div>
