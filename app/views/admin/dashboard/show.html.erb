<div class="space-y-8">
  <h1 class="text-3xl font-semibold tracking-tight text-zinc-900"><%= t("admin.dashboard.title") %></h1>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-sm">
      <p class="text-sm text-zinc-600"><%= t("admin.dashboard.accounts") %></p>
      <p class="mt-2 text-3xl font-semibold text-zinc-900"><%= @accounts_count %></p>
    </div>
    <div class="rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-sm">
      <p class="text-sm text-zinc-600"><%= t("admin.dashboard.active_subscriptions") %></p>
      <p class="mt-2 text-3xl font-semibold text-zinc-900"><%= @active_subscriptions_count %></p>
    </div>
    <div class="rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-sm">
      <p class="text-sm text-zinc-600"><%= t("admin.dashboard.plans") %></p>
      <p class="mt-2 text-3xl font-semibold text-zinc-900"><%= @plans_count %></p>
    </div>
    <div class="rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-sm">
      <p class="text-sm text-zinc-600"><%= t("admin.dashboard.features") %></p>
      <p class="mt-2 text-3xl font-semibold text-zinc-900"><%= @features_count %></p>
    </div>
  </div>

  <section class="rounded-2xl border border-zinc-200/80 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-zinc-900"><%= t("admin.dashboard.recent_accounts") %></h2>
    <% if @recent_accounts.any? %>
      <ul class="mt-4 divide-y divide-zinc-100">
        <% @recent_accounts.each do |account| %>
          <li class="flex items-center justify-between py-3 text-sm">
            <div>
              <span class="font-medium text-zinc-900"><%= account.name %></span>
              <span class="ml-2 text-zinc-500"><%= account.subdomain %></span>
            </div>
            <%= link_to t("admin.accounts.view"), admin_account_path(account), class: "text-indigo-600 hover:text-indigo-500" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-sm text-zinc-600"><%= t("admin.dashboard.no_accounts") %></p>
    <% end %>
  </section>
</div>
