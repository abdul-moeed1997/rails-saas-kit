<div class="mx-auto w-full max-w-md">
  <div class="rounded-2xl border border-zinc-200/80 bg-white p-8 shadow-sm shadow-zinc-950/5 ring-1 ring-zinc-950/5">
    <header class="mb-8 text-center">
      <h1 class="text-2xl font-semibold tracking-tight text-zinc-900"><%= title %></h1>
      <% if local_assigns[:subtitle].present? %>
        <p class="mt-2 text-sm leading-relaxed text-zinc-600"><%= subtitle %></p>
      <% end %>
    </header>
    <%= yield %>
  </div>
</div>
