#!/bin/sh
# Run RuboCop with safe autocorrect on staged Ruby files before each commit.
set -e
cd "$(git rev-parse --show-toplevel)"

STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(rb|rake)$' || true)
if [ -z "$STAGED" ]; then
  exit 0
fi

bin/rubocop -a --force-exclusion $STAGED
git add $STAGED
